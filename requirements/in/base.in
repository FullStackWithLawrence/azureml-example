# -----------------------------------------------------------------------------
# written by: Lawrence McDaniel
#             https://lawrencemcdaniel.com
#
# usage:      The common runtime requirements, shared by local development,
#             the Docker image and CI.
#
#             pip-compile --upgrade requirements/in/base.in -o requirements/base.txt
# -----------------------------------------------------------------------------

-r constraints.in

# General
# ------------
python-dotenv                           # for loading environment variables from .env files
kaggle                                  # for Kaggle api access
six                                     # kaggle imports six but doesn't declare it
openpyxl                                # for Excel file support from kaggle datasets

# Data science
# ------------
pandas                                  # for data manipulation
seaborn                                 # for data visualization
scikit-learn                            # for machine learning algorithms
scipy                                   # for scientific computing
shap                                    # for model interpretability

# Azure Machine Learning SDK v2
# ------------
azure-ai-ml                             # Azure ML v2 SDK: workspaces, data assets, compute, AutoML jobs, endpoints
azure-identity                          # DefaultAzureCredential, for authenticating MLClient
azure-storage-blob                      # Azure Blob Storage client, for downloading data assets
