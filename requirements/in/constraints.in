# -----------------------------------------------------------------------------
# written by: Lawrence McDaniel
#             https://lawrencemcdaniel.com
#
# usage:      additional global version constraints.
#             -r constraints.in
#
#             Compile every .in file with Python 3.14, the Makefile's
#             interpreter, so that pip-compile only picks releases that support it.
# -----------------------------------------------------------------------------
pandas<2                                # the Azure ML v1 SDK (azureml-train-automl 1.60.x) requires pandas 1.5.x
scikit-learn<1.6                        # AutoML pins scikit-learn 1.5.x
